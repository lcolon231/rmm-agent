# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://rmm:rmm@localhost:5432/rmm

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Enrollment tokens always expire and default to one use.
ENROLLMENT_TOKEN_DEFAULT_EXPIRY_HOURS=24
ENROLLMENT_TOKEN_MAX_EXPIRY_DAYS=30
ENROLLMENT_TOKEN_MAX_USES=100
# Process-local source-IP limiter. Use a shared backend before multi-worker HA.
ENROLLMENT_RATE_LIMIT_ATTEMPTS=10
ENROLLMENT_RATE_LIMIT_WINDOW_SECONDS=60

# Path to the Ed25519 private key created by scripts/gen_command_keys.py
COMMAND_SIGNING_KEY_PATH=command_signing_key.pem
# Optional JSON registry for staged key activation/overlap/retirement.
# COMMAND_SIGNING_KEYRING_PATH=command_keyring.json
COMMAND_SIGNING_KEY_ID=default

HEARTBEAT_INTERVAL_SECONDS=60
COMMAND_REDELIVERY_SECONDS=120
OFFLINE_AFTER_MISSED=3

# Alert transition email is opt-in. Keep disabled until the sender domain and
# recipients are validated. Never commit the real API key.
EMAIL_ALERT_PROVIDER=disabled
# EMAIL_ALERT_RESEND_API_KEY=re_...
# EMAIL_ALERT_SENDER=NodeLink Alerts <alerts@example.com>
# EMAIL_ALERT_RECIPIENTS=oncall@example.com,security@example.com
# EMAIL_ALERT_DASHBOARD_BASE_URL=https://rmm.example.com
EMAIL_ALERT_POLL_INTERVAL_SECONDS=15
EMAIL_ALERT_BATCH_SIZE=25
EMAIL_ALERT_MAX_ATTEMPTS=5
EMAIL_ALERT_BACKOFF_BASE_SECONDS=30
EMAIL_ALERT_BACKOFF_MAX_SECONDS=3600
EMAIL_ALERT_CLAIM_TIMEOUT_SECONDS=300
EMAIL_ALERT_REQUEST_TIMEOUT_SECONDS=10

# Signed webhooks are configured through the operator API/dashboard. Generate
# the at-rest encryption key once and keep it stable across deployments:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# WEBHOOK_SECRET_ENCRYPTION_KEY=...
WEBHOOK_POLL_INTERVAL_SECONDS=15
WEBHOOK_BATCH_SIZE=25
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=30
WEBHOOK_BACKOFF_MAX_SECONDS=3600
WEBHOOK_CLAIM_TIMEOUT_SECONDS=300
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_DNS_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ENDPOINTS=50

# Typed script parameter values are encrypted as one expiring document with
# AES-256-GCM. Supply 32 bytes as urlsafe base64 (the '-_' alphabet); any other
# length or encoding makes value preparation fail closed with 503. Generate it
# separately from WEBHOOK_SECRET_ENCRYPTION_KEY and keep it stable until every
# prepared value set has expired or been consumed — the same key also derives
# the HMAC idempotency fingerprint, so rotating it turns retries into conflicts.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# SCRIPT_PARAMETER_ENCRYPTION_KEY=...
SCRIPT_PARAMETER_VALUE_TTL_SECONDS=86400
SCRIPT_PARAMETER_MAX_VALUES_BYTES=32768
SCRIPT_PARAMETER_MAX_SETS_PER_VERSION=10000

# MeshCentral remote desktop (issue #62). MeshCentral is a separate trust
# boundary; NodeLink only authorizes, identity-maps, and audits a session launch
# and mints a short-lived single-device access URL. Disabled by default; every
# launch is refused until enabled. The admin token is environment-only and never
# persisted or returned. See docs/MESHCENTRAL-INTEGRATION.md before enabling.
MESHCENTRAL_PROVIDER=disabled
# MESHCENTRAL_BASE_URL=https://meshcentral.example.com
# MESHCENTRAL_ADMIN_TOKEN=...
# MESHCENTRAL_ADMIN_USERNAME=...
# 32-byte urlsafe base64 AES-GCM key (same generator as WEBHOOK_SECRET_ENCRYPTION_KEY):
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# MESHCENTRAL_LOGIN_COOKIE_ENCRYPTION_KEY=...
# MESHCENTRAL_TLS_PIN_SHA256=...
MESHCENTRAL_LOGIN_TTL_SECONDS=120
MESHCENTRAL_REQUEST_TIMEOUT_SECONDS=10
MESHCENTRAL_DNS_TIMEOUT_SECONDS=5
MESHCENTRAL_MAPPING_SYNC_INTERVAL_SECONDS=900
MESHCENTRAL_MAPPING_STALE_AFTER_SECONDS=86400
MESHCENTRAL_MAX_LAUNCHES_PER_OPERATOR_PER_MINUTE=5
