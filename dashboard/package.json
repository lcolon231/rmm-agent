{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:production": "node scripts/production-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/support/module-hooks.mjs --test \"test/*.test.ts\" && npm run test:ui",
    "test:coverage": "c8 npm test",
    "validate:env": "node --experimental-strip-types scripts/validate-environment.ts",
    "test:ui": "node --import tsx --import ./test/ui/setup-dom.ts --experimental-test-module-mocks --test \"test/ui/**/*.test.tsx\""
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^12.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
