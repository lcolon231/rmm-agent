{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodelink.invalid/contracts/webhook-event-v1.schema.json",
  "title": "NodeLink signed webhook event, api_version 2026-08-05 (issues #46, #72)",
  "description": "Body of every signed webhook delivery. Canonical JSON: sorted keys, no insignificant whitespace, UTF-8. Within one api_version fields are only added, never removed or redefined, so receivers must ignore unknown properties; this schema therefore allows additional properties. The signature covers the exact raw body bytes; see docs/WEBHOOK-EVENTS.md.",
  "type": "object",
  "required": [
    "api_version",
    "delivery_id",
    "event_id",
    "event_type",
    "occurred_at",
    "data"
  ],
  "properties": {
    "api_version": {
      "const": "2026-08-05"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "event_type": {
      "enum": [
        "monitoring.alert.opened",
        "monitoring.alert.reopened",
        "monitoring.alert.acknowledged",
        "monitoring.alert.manual_resolution",
        "monitoring.alert.automatic_recovery",
        "monitoring.alert.policy_revised",
        "monitoring.alert.policy_deleted",
        "monitoring.alert.policy_superseded"
      ]
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "data": {
      "type": "object",
      "required": [
        "alert"
      ],
      "properties": {
        "alert": {
          "type": "object",
          "required": [
            "id",
            "endpoint_id",
            "policy_id",
            "policy_revision_id",
            "check_key",
            "generation",
            "from_state",
            "to_state",
            "result_status",
            "last_value"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "endpoint_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "policy_revision_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "check_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "from_state": {
              "enum": [
                null,
                "open",
                "acknowledged",
                "resolved"
              ]
            },
            "to_state": {
              "enum": [
                "open",
                "acknowledged",
                "resolved"
              ]
            },
            "result_status": {
              "enum": [
                "ok",
                "warning",
                "critical",
                "unknown"
              ]
            },
            "last_value": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
